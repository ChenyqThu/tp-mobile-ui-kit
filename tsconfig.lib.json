{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "noEmit": false,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/lib",
    "src/theme",
    "src/core",
    "src/assets-lib",
    "src/omada",
    "src/vite-env.d.ts"
  ],
  "exclude": ["src/tests", "src/showcase", "src/demos"]
}
